clc;
clear;
close all;

% TWO AREA LOAD FREQUENCY CONTROL
s = tf('s');

%% Area-1 Parameters
Tg1 = 0.2;      % Governor Time Constant
Tt1 = 1.0;      % Turbine Time Constant
Tp1 = 10;        % Power System Time Constant
Kp1 = 100;       % Power System Gain
R1  = 0.05;       % Speed Regulation

%% Area-2 Parameters

Tg2 = 0.2;
Tt2 = 1.0;
Tp2 = 10;
Kp2 = 100;
R2  = 0.;

%% Tie Line Coefficient

T12 = 0.545;

%% Governor

Gg1 = tf(1,[Tg1 1]);
Gg2 = tf(1,[Tg2 1]);

%% Turbine

Gt1 = tf(1,[Tt1 1]);
Gt2 = tf(1,[Tt2 1]);

%% Generator

Gp1 = tf(Kp1,[Tp1 1]);
Gp2 = tf(Kp2,[Tp2 1]);

%% Open Loop Transfer Functions

Area1_OL = Gg1*Gt1*Gp1;
Area2_OL = Gg2*Gt2*Gp2;

%% Closed Loop Transfer Functions

Area1 = feedback(Area1_OL,1/R1);
Area2 = feedback(Area2_OL,1/R2);

%% Simulation Time

t = 0:0.01:100;

%% Load Disturbance

DeltaPL = 0.05;

u = DeltaPL*ones(size(t));

%% Area-1 Response

[df1,t] = lsim(Area1,u,t);

%% Tie-Line Model

TieLine = tf(T12,[1 0]);

Ptie = lsim(TieLine,df1,t);

%% Area-2 Response

df2 = lsim(Area2,Ptie,t);

%%===========================
% PLOTS
%%===========================

figure;

subplot(3,1,1)

plot(t,df1,'b','LineWidth',2)

grid on

xlabel('Time (sec)')

ylabel('\Delta f_1 (Hz)')

title('Area-1 Frequency Deviation')

subplot(3,1,2)

plot(t,df2,'r','LineWidth',2)

grid on

xlabel('Time (sec)')

ylabel('\Delta f_2 (Hz)')

title('Area-2 Frequency Deviation')

subplot(3,1,3)

plot(t,Ptie,'k','LineWidth',2)

grid on

xlabel('Time (sec)')

ylabel('\Delta P_{tie}')

title('Tie-Line Power Deviation')

%%===========================
% STEP INFORMATION
%%===========================

disp('Area-1 Step Information')
stepinfo(df1,t)

disp('Area-2 Step Information')
stepinfo(df2,t)

%%===========================
% ROOT LOCUS
%%===========================

figure

rlocus(Area1)

title('Root Locus Area-1')

grid on

figure

rlocus(Area2)

title('Root Locus Area-2')

grid on

%%===========================
% BODE PLOT
%%===========================

figure

bode(Area1)

grid on

title('Bode Plot Area-1')

figure

bode(Area2)

grid on

title('Bode Plot Area-2')

%%===========================
% POLE ZERO MAP
%%===========================

figure

pzmap(Area1)

grid on

title('Pole-Zero Map Area-1')

figure

pzmap(Area2)

grid on

title('Pole-Zero Map Area-2')

%%===========================
% IMPULSE RESPONSE
%%===========================

figure

impulse(Area1)

grid on

title('Impulse Response Area-1')

figure

impulse(Area2)

grid on

title('Impulse Response Area-2')